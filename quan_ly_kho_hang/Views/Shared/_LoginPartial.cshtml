@using Microsoft.AspNetCore.Identity
@using quan_ly_kho_hang.Models

@inject SignInManager<AppUser> SignInManager
@inject UserManager<AppUser> UserManager

<style>
    .reset-btn {
        all: unset !important;
        cursor: inherit !important;
        display: inline !important;
        font: inherit !important;
        color: inherit !important;
        background: none !important;
        border: none !important;
        padding: 0 !important;
        margin: 0 !important;
        width: 100% !important;
        height: 100% !important; 
        
    }
</style>

@if (SignInManager.IsSignedIn(User))
{
    <form asp-area="Identity" asp-controller="Account" asp-action="LogOff" method="post" id="logoutForm" class="navbar-right">
        <div class="profile-box ml-15">
            <button
            class="dropdown-toggle bg-transparent border-0"
            type="button"
            id="profile"
            data-bs-toggle="dropdown"
            aria-expanded="false"
            >
            <div class="profile-info">
                <div class="info">
                <!-- <h6>John Doe</h6> -->
                <div class="image">
                    <img
                    src="~/assets/images/profile/user-avatar.png"
                    alt=""
                    />
                    <span class="status"></span>
                </div>
                </div>
            </div>
            <i class="lni lni-chevron-down"></i>
            </button>
            <ul
            class="dropdown-menu dropdown-menu-end"
            aria-labelledby="profile"
            >
            <li>
                <a asp-area="Identity"  asp-controller="Manage" asp-action="Index">
                <i class="lni lni-user"></i> Tài khoản
                </a>
            <li>
                <a href=""> <i class="lni lni-exit"></i>
                    <button class="reset-btn" type="submit">Đăng xuất</button>
                </a>
            </li>
            </ul>
        </div>
    </form>
}
else
{
    <div class="d-flex align-items-center">
        <a class="main-btn dark-btn-outline me-2 rounded-full btn-hover" asp-area="Identity" asp-controller="Account" asp-action="Register">Đăng ký</a>
        <a class="main-btn dark-btn-outline rounded-full btn-hover" asp-area="Identity" asp-controller="Account" asp-action="Login">Đăng nhập</a>
    </div>
}