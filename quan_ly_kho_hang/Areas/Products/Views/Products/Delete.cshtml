@model quan_ly_kho_hang.Models.Product

@{
    ViewData["Title"] = "Xóa sản phẩm";
    ViewData["Slug"] = "delete";
}

<h3>Bạn có chắc chắn muốn xóa sản phẩm này?</h3>

<div>
    <h4>@Model.Name</h4>
    <p>@Model.Description</p>
    <p>Số lượng: @Model.Quantity</p>
    <p>Giá: @Model.Price</p>

    @if (!string.IsNullOrEmpty(Model.ImagePath))
    {
        <img src="@Model.ImagePath" alt="Ảnh sản phẩm" style="max-height:150px;" />
    }
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Xóa</button>
    <a asp-action="Index" class="btn btn-secondary">Hủy</a>
</form>
