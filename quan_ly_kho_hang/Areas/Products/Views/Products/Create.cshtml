@model quan_ly_kho_hang.Models.Product

@{
    ViewData["Title"] = "Thêm sản phẩm";
    ViewData["Slug"] = "Thêm mới";
}

<div class="input-style-1">
    <form asp-action="Create" method="post" enctype="multipart/form-data">
        <div asp-validation-summary="All" class="text-danger"></div>
        <div class="form-group">
            <label>Tên sản phẩm</label>
            <input asp-for="Name" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label>Mô tả sản phẩm</label>
            <textarea placeholder="Message" rows="5" asp-for="Description"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label>Số lượng</label>
            <input asp-for="Quantity" type="number" />
            <span asp-validation-for="Quantity" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label>Giá</label>
            <input asp-for="Price" type="number" step="0.01" />
            <span asp-validation-for="Price" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label>Ảnh sản phẩm</label>
            <input asp-for="ImagePath" type="file" name="imageFile" />
        </div>

        <button type="submit" class="main-btn success-btn-outline rounded-md btn-hover my-3">Lưu</button>
        <a asp-action="Index" class="main-btn success-btn-outline rounded-md btn-hover my-3">Quay lại</a>
    </form>

</div>
