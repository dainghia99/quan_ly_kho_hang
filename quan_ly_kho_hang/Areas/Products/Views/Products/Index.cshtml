@model IEnumerable<quan_ly_kho_hang.Models.Product>
@{
    ViewData["Title"] = "Quản lý sản phẩm";
    ViewData["Slug"] = "product";
}


<a asp-action="Create" class="btn btn-primary mb-3">Thêm mới</a>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Tên</th>
            <th>Số lượng</th>
            <th>Giá trung bình khi nhập kho</th>
            <th>Hình ảnh</th>
            <th>Tùy chọn</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Name</td>
            <td>@item.Quantity</td>
            <td>@item.Price</td>
            <td>
                @if (!string.IsNullOrEmpty(item.ImagePath))
                {
                    <img src="@item.ImagePath" width="80" />
                }
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Chỉnh sửa</a>
                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Xóa</a>
            </td>
        </tr>
    }
    </tbody>
</table>
