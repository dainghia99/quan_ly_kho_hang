@model quan_ly_kho_hang.Models.Product

@{
    ViewData["Title"] = "Chỉnh sửa sản phẩm";
    ViewData["Slug"] = "edit";
}

<div class="input-style-1">
    <form asp-action="Edit" method="post" enctype="multipart/form-data">
        <input type="hidden" asp-for="Id" />

        <div class="form-group">
            <label asp-for="Name"></label>
            <input asp-for="Name"/>
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Description"></label>
            <textarea asp-for="Description" placeholder="Message" rows="5"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Quantity"></label>
            <input asp-for="Quantity" type="number" />
            <span asp-validation-for="Quantity" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Price"></label>
            <input asp-for="Price" type="number" step="0.01" />
            <span asp-validation-for="Price" class="text-danger"></span>
        </div>

        @if (!string.IsNullOrEmpty(Model.ImagePath))
        {
            <div class="form-group my-8">
                <label  class="my-8">Ảnh hiện tại</label>
                <img src="@Model.ImagePath" alt="Ảnh sản phẩm" style="max-height:150px;" />
            </div>
        }

        <div class="form-group my-5">
            <label>Đổi ảnh mới</label>
            <input type="file" name="imageFile" />
        </div>

        <button type="submit" class="main-btn success-btn-outline rounded-md btn-hover my-3">Cập nhật</button>
        <a asp-action="Index" class="main-btn success-btn-outline rounded-md btn-hover my-3">Quay lại</a>
    </form>
</div>