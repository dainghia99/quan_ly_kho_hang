@model IEnumerable<quan_ly_kho_hang.Models.Reports.SalesSummaryDto>
@{
    ViewData["Title"] = "Báo cáo bán hàng";
    var from = ViewBag.From as DateTime?;
    var to = ViewBag.To as DateTime?;
    var groupBy = ViewBag.GroupBy as string ?? "day";
}

<h1>Báo cáo bán hàng</h1>

<form asp-action="Sales" asp-area="Reports" method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <input type="date" name="from" class="form-control"
               value="@(from?.ToString("yyyy-MM-dd"))" />
    </div>
    <div class="col-auto">
        <input type="date" name="to" class="form-control"
               value="@(to?.ToString("yyyy-MM-dd"))" />
    </div>
    <div class="col-auto">
        <select name="groupBy" class="form-select">
            <option value="day" selected="@(groupBy=="day")">Theo ngày</option>
            <option value="month" selected="@(groupBy=="month")">Theo tháng</option>
        </select>
    </div>
    <div class="col-auto">
        <button class="btn btn-primary">Lọc</button>
    </div>
    <div class="col-auto">
        <a asp-action="ExportSalesToExcel" asp-area="Reports"
           asp-route-from="@(from?.ToString("yyyy-MM-dd"))"
           asp-route-to="@(to?.ToString("yyyy-MM-dd"))"
           asp-route-groupBy="@groupBy"
           class="btn btn-success">Xuất Excel</a>
    </div>
    <div class="col-auto">
        <a asp-action="ExportSalesToPdf" asp-area="Reports"
           asp-route-from="@(from?.ToString("yyyy-MM-dd"))"
           asp-route-to="@(to?.ToString("yyyy-MM-dd"))"
           asp-route-groupBy="@groupBy"
           class="btn btn-danger">Xuất PDF</a>
    </div>
</form>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Ngày/Tháng</th>
            <th>Số lượng</th>
            <th>Doanh thu</th>
        </tr>
    </thead>
    <tbody>
    @foreach(var r in Model)
    {
        <tr>
            <td>@(groupBy == "month" ? r.Period.ToString("yyyy-MM") : r.Period.ToString("yyyy-MM-dd"))</td>
            <td>@r.TotalQuantity</td>
            <td>@String.Format("{0:N0}", r.TotalRevenue)</td>
        </tr>
    }
    </tbody>
</table>
