@model IEnumerable<quan_ly_kho_hang.Models.Reports.SalesSummaryDto>
@{
    ViewData["Title"] = "Báo cáo bán hàng";
}

<h1>Báo cáo bán hàng</h1>

<form class="row g-2 mb-3" method="get">
    <div class="col-auto">
        <input type="date" name="from" class="form-control" value="@Context.Request.Query["from"]" />
    </div>
    <div class="col-auto">
        <input type="date" name="to" class="form-control" value="@Context.Request.Query["to"]" />
    </div>
    <div class="col-auto">
        <select name="groupBy" class="form-select">
            <option value="day" selected="@(Context.Request.Query["groupBy"]=="day")">Theo ngày</option>
            <option value="month" selected="@(Context.Request.Query["groupBy"]=="month")">Theo tháng</option>
        </select>
    </div>
    <div class="col-auto">
        <button class="btn btn-primary">Lọc</button>
    </div>
    <div class="col-auto">
        <a asp-action="ExportSalesToExcel" asp-route-from="@Context.Request.Query["from"]" asp-route-to="@Context.Request.Query["to"]" asp-route-groupBy="@Context.Request.Query["groupBy"]" class="btn btn-success">
            Xuất Excel
        </a>
    </div>
    <div class="col-auto">
        <a asp-action="ExportSalesToPdf" asp-route-from="@Context.Request.Query["from"]" asp-route-to="@Context.Request.Query["to"]" asp-route-groupBy="@Context.Request.Query["groupBy"]" class="btn btn-danger">
            Xuất PDF
        </a>
    </div>
</form>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Ngày/Tháng</th>
            <th>Số lượng</th>
            <th>Doanh thu</th>
        </tr>
    </thead>
    <tbody>
    @foreach(var r in Model)
    {
        <tr>
            <td>@r.Period.ToString("yyyy-MM-dd")</td>
            <td>@r.TotalQuantity</td>
            <td>@String.Format("{0:N0}", r.TotalRevenue)</td>
        </tr>
    }
    </tbody>
</table>
