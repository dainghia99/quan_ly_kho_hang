@model IEnumerable<quan_ly_kho_hang.Models.Reports.InventoryValuationDto>
@{
    ViewData["Title"] = "Định Giá Tồn Kho";
    ViewData["Slug"] = "Định giá tồn kho";
}

<div class="row">
    <div class="col-lg-12">
    <div class="card-style mb-30">
        <h6 class="mb-10">Định Giá Tồn Kho</h6>
        <p class="text-sm mb-20">
        Danh sách các sản phẩm tồn kho và giá trị
        </p>
        <div class="table-wrapper table-responsive">
        <table class="table">
            <thead>
            <tr>
                <th><h6>Sản Phẩm</h6></th>
                <th><h6>Số Lượng</h6></th>
                <th><h6>Giá Đơn Vị</h6></th>
                <th><h6>Giá Trị</h6></th>
                <th><h6></h6></th>
            </tr>
            <!-- end table row-->
            </thead>
            <tbody>
                @foreach (var r in Model)
                {
                    <tr>
                        
                        <td class="min-width">
                            <div class="lead">
                                <div class="lead-text">
                                    <p>@r.ProductName</p>
                                </div>
                            </div>
                        </td>
                            
                        
                        
                        <td>
                            <div class="lead">
                                <div class="lead-text">
                                    <p>@r.Quantity</p>
                                </div>
                            </div>
                        </td>

                        <td>
                            <div class="lead">
                                <div class="lead-text">
                                    <p>@String.Format("{0:N0}", r.UnitPrice) VNĐ</p>
                                </div>
                            </div>
                        </td>

                        <td>
                            <div class="lead">
                                <div class="lead-text">
                                    <p>@String.Format("{0:N0}", r.TotalValue) VNĐ</p>
                                </div>
                            </div>
                        </td>
                        
                  
                        <td>
                            
                        </td>
                    </tr>
                }

            
            </tbody>
            <tfoot>
                <tr>
                    <th colspan="3">Tổng</th>
                    <th>@String.Format("{0:N0}", Model.Sum(m => m.TotalValue)) VNĐ</th>
                </tr>
            </tfoot>
        </table>
        <!-- end table -->
        </div>
    </div>
    <!-- end card -->
    </div>
    <!-- end col -->
</div>
