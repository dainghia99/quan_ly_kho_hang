@model EditExtraProfileModel
@{
    ViewData["Title"] = "Hồ sơ cá nhân";
    ViewData["Slug"] = "Chỉnh sửa hồ sơ các nhân";
}

<partial name="_StatusMessage" />

<div class="row">
    <div class="input-style-1 col-md-6">
        <form id="profile-form" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="UserName"></label>
                <input asp-for="UserName" disabled />
            </div>
            <div class="form-group">
                <label asp-for="UserEmail"></label>
                <input asp-for="UserEmail" disabled />
            </div>

            <div class="form-group">
                <label asp-for="PhoneNumber"></label>
                <input asp-for="PhoneNumber" disabled/>
            </div>         

            <button id="update-profile-button" type="submit" class="main-btn success-btn-outline rounded-md btn-hover my-3">Lưu dữ liệu</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}



