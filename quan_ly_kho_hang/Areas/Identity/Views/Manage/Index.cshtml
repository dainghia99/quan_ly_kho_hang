@model IndexViewModel
@{
    ViewData["Title"] = "Quản lý tài khoản của bạn";
    Layout = "~/Areas/Identity/Views/Account/_LayoutLogin.cshtml";
}
<p class="text-success">@ViewData["StatusMessage"]</p>

@* Start *@
      <section class="section">
        <div class="container-fluid">
          <div class="row">
            <div class="col-lg-6">
              <div class="card-style settings-card-1 mb-30">
                <div
                  class="
                    title
                    mb-30
                    d-flex
                    justify-content-between
                    align-items-center
                  "
                >
                  <h6>Thông tin tài khoản</h6>
                  <button class="border-0 bg-transparent">
                    <i class="lni lni-pencil-alt"></i>
                  </button>
                </div>
                <div class="profile-info">
                  <div class="d-flex align-items-center mb-30">
                    <div class="profile-image">
                      <img src="~/assets/images/profile/user-avatar.png" alt="" />
                      @* <div class="update-image">
                        <input type="file" />
                        <label for=""
                          ><i class="lni lni-cloud-upload"></i
                        ></label>
                      </div> *@
                    </div>
                    <div class="profile-meta">
                      <h5 class="text-bold text-dark mb-10">@Html.DisplayFor(m => Model.profile.UserName)</h5>
                      <p class="text-sm text-gray">@Html.DisplayFor(m => Model.profile.UserEmail)</p>
                    </div>
                  </div>
                  <div class="input-style-1">
                    <label>Địa chỉ Email: </label>
                    <span>
                      @Html.DisplayFor(m => Model.profile.UserEmail)
                    </span>
                  </div>
                  <div class="input-style-1">
                    <label>Số điện thoại</label>
                    <span>
                      @Html.DisplayFor(m => Model.profile.PhoneNumber)
                    </span>
                  </div>
                  
                  @* <div class="input-style-1">
                    <label>Website</label>
                    <input
                      type="text"
                      placeholder="www.uideck.com"
                      value="www.uideck.com"
                    />
                  </div>
@*                   <div class="input-style-1">
                    <label>Bio</label>
                    <textarea placeholder="Write your bio here" rows="4">
Crafted for – Business, Startup, SaaS, Apps, Event, Software, Agency, Resume and Portfolio. All Landing Pages comes with clean design and responsive layout. Also packed with all essential sections, elements, and features you need to launch</textarea
                    >
                  </div> *@
                </div>
                <a asp-action="EditProfile" class="main-btn success-btn-outline rounded-md btn-hover my-3">Sửa thông tin</a>
              </div>
              <!-- end card -->
            </div>
            <!-- end col -->

            <div class="col-lg-6">
              <div class="card-style settings-card-2 mb-30">
                <div class="title mb-30">
                  <h6>Thông tin khác</h6>
                </div>

                 <dt class="col-sm-4">Mật khẩu</dt>
                    <dd class="col-sm-6 d-flex">
                        @if (Model.HasPassword)
                        {
                            <a class="main-btn success-btn-outline rounded-md btn-hover mx-3 my-3" asp-controller="Manage" asp-action="ChangePassword">Đổi mật khẩu</a>
                        }
                        else
                        {
                            <a class="main-btn success-btn-outline rounded-md btn-hover mx-3 my-3" asp-controller="Manage" asp-action="SetPassword">Tạo mật khẩu</a>
                        }
                    </dd>
                 </dt>

                 <dt class = "col-sm-4">Liên kết tài khoản ngoài:</dt>
                    <dd class = "col-sm-6">
                        Có @Model.Logins.Count liên kết <a class="main-btn success-btn-outline rounded-md btn-hover mx-3 my-3" asp-controller="Manage" asp-action="ManageLogins">Quản lý liên kết ngoài</a>
                    </dd>
                 </dt>

                 <dt class="col-sm-4">Số điện thoại</dt>
                 <dd class = "col-sm-6">
                    <p>
                        Số điện thoại dùng để xác thực hai yêu tố:
                    </p>
                    @(Model.PhoneNumber ?? "Không có")
                        @if (Model.PhoneNumber != null)
                        {
                            <text>:</text>
                            <text>&nbsp;&nbsp;<a class="main-btn success-btn-outline rounded-md btn-hover mx-3 my-3" asp-controller="Manage" asp-action="AddPhoneNumber">Thay đổi</a>&nbsp;&nbsp;</text>
                            <form asp-controller="Manage" asp-action="RemovePhoneNumber" method="post" role="form">
                                <button type="submit" class="main-btn danger-btn-outline rounded-md btn-hover">Loại bỏ số điện thoại</button>
                            </form>
                        }
                        else
                        {
                            <text>&nbsp;&nbsp;<a class="main-btn success-btn-outline rounded-md btn-hover mx-3 my-3" asp-controller="Manage" asp-action="AddPhoneNumber">Thêm số điện thoại</a></text>
                        }
                  </dd>

                  <dt class="col-sm-4">Xác thực hai yếu tố:</dt>
                    <dd class = "col-sm-6">
                        @if (Model.TwoFactor)
                            {
                                <form asp-controller="Manage" asp-action="DisableTwoFactorAuthentication" method="post" class="form-horizontal" role="form">
                                    (Đang kích hoạt) <button type="submit" class="main-btn danger-btn-outline rounded-md btn-hover">Hủy</button>
                                </form>
                            }
                            else
                            {
                                <form asp-controller="Manage" asp-action="EnableTwoFactorAuthentication" method="post" class="form-horizontal" role="form">
                                    <button type="submit" class="main-btn success-btn-outline rounded-md btn-hover mx-3 my-3">Kích hoạt</button>
                                </form>
                            }
                    </dd>

                <dt class="col-sm-4">Xác thực ứng dụng:</dt>
                <dd class = "col-sm-6">
                    @if (Model.AuthenticatorKey == null)
                    {
                        <form asp-controller="Manage" asp-action="ResetAuthenticatorKey" method="post" class="form-horizontal" role="form">
                            <button type="submit" class="main-btn success-btn-outline rounded-md btn-hover mx-3 my-3">Phát sinh mã</button>
                        </form>
                    }
                    else
                    {
                        <text>Mã xác thực là: @Model.AuthenticatorKey</text>
                        <p>Nhập mã này khi yêu cầu xác thực 2 yếu tố</p>
                        <form asp-controller="Manage" asp-action="GenerateRecoveryCode" method="post" class="form-horizontal" role="form">
                           <button type="submit" class="main-btn success-btn-outline rounded-md btn-hover mx-3 my-3">Phát sinh mã phục hồi</button>
                           <p>Mã phục hồi sử dụng để xác thực hai yếu tố</p>
                        </form>
                    }
                </dd>
              </div>
              <!-- end card -->
            </div>
            <!-- end col -->
          </div>
          <!-- end row -->
        </div>
        <!-- end container -->
      </section>