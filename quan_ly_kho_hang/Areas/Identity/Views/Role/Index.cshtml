@model List<RoleModel>
@{
    ViewData["Title"] = "Vai Trò";
    
    ViewData["Slug"] = "Role";
}

<partial name="_StatusMessage"></partial>

<div class="row">
    <div class="col-lg-12">
    <div class="card-style mb-30">
        <h6 class="mb-10">Danh sách các tài khoản trong hệ thống</h6>
        <p class="text-sm mb-20">
        Danh sách các vai trò (role) trong hệ thống
        </p>
        <div class="table-wrapper table-responsive">
        <table class="table">
            <thead>
            <tr>
                <th><h6 class="text-center">Tên Role (vai trò)</h6></th>
                <th><h6></h6></th>
                <th><h6></h6></th>
                <th><h6></h6></th>
                <th><h6 class="text-center">Tác vụ</h6></th>
            </tr>
            <!-- end table row-->
            </thead>
            <tbody>
            <tr>
                @foreach (var role in Model)
                {
                    <tr>
                        <td>
                            <p>@role.Name</p>
                            @foreach (var claim in @role.Claims)
                            {
                                <small>@claim</small><br>
                            }
                        </td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td class="d-flex justify-content-center">
                            <a class="main-btn mx-2 light-btn-outline rounded-md btn-hover" asp-action="Edit" asp-route-roleid="@role.Id">Cập nhật</a>
                            <a class="main-btn danger-btn-outline rounded-md btn-hover" asp-action="Delete" asp-route-roleid="@role.Id">Xóa</a>
                        </td>
                    </tr>
                }

            </tr>
            <!-- end table row -->
            </tbody>
        </table>
        <!-- end table -->
        </div>
    </div>
    <!-- end card -->
    </div>
    <!-- end col -->
</div>

<div class="mb-2">
    <a class="main-btn success-btn-outline rounded-md btn-hover" asp-action="Create">Tạo role mới</a>
    <a class="main-btn success-btn-outline rounded-md btn-hover" asp-action="Index" asp-controller="User">Quản lý thành viên</a>
</div>