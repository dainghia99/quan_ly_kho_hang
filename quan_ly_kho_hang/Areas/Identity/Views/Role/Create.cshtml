@model CreateRoleModel
@{
    ViewData["Title"] = "Tạo Role Mới";
}

<partial name="_StatusMessage"></partial>



<div class="row">
    <div class="input-style-1 col-md-6">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Name"></label>
                <input asp-for="Name"/>
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="form-group">
                <button type="submit" class="my-3 main-btn success-btn-outline rounded-md btn-hover">Tạo mới</button>
                <a class="my-3 main-btn success-btn-outline rounded-md btn-hover" asp-action="Index">Danh sách các role</a>
            </div>
        </form>
    </div>
</div>


@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
