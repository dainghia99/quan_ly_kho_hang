@model SetUserPasswordModel
@{
    ViewData["Title"] = "Đặt mật khẩu";
    ViewData["Slug"] = "Đặt lại mật khẩu";
}

<p class="my-3">Thiết lập mật khẩu cho thành viên: <b>@ViewBag.user.UserName</b></p>
<partial name="_StatusMessage" />

<div class="row">
    <div class="input-style-1 col-md-6">
        <form id="set-password-form" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="NewPassword"></label>
                <input asp-for="NewPassword"/>
                <span asp-validation-for="NewPassword" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ConfirmPassword"></label>
                <input asp-for="ConfirmPassword"/>
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>
            <button type="submit" class="main-btn success-btn-outline rounded-md btn-hover">Đặt mật khẩu</button>
            <a class="main-btn success-btn-outline rounded-md btn-hover" asp-action="Index">Danh sách thành viên</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
