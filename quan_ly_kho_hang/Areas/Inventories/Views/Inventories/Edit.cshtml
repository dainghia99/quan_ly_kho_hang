@model quan_ly_kho_hang.Models.Inventory
@{
    ViewData["Title"] = "Sửa kiểm kê";
    ViewData["Slug"] = "Sửa thông tin";
    var products = ViewBag.Products as IEnumerable<quan_ly_kho_hang.Models.Product> ?? new List<quan_ly_kho_hang.Models.Product>();
}

<div class="input-style-1">
    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="Id" />
        <div class="mb-3">
            <label class="form-label">Ghi chú</label>
            <input asp-for="Notes" class="form-control" />
        </div>

        <h5>Mục kiểm kê</h5>
        <table class="table">
            <thead>
                <tr>
                    <th>Sản phẩm</th>
                    <th>Tồn hệ thống</th>
                    <th>Đếm thực tế</th>
                    <th>Ghi chú</th>
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < Model.Items.Count; i++)
                {
                    <tr>
                        <td>
                            <input type="hidden" asp-for="Items[@i].ProductId" />
                            @Model.Items[i].ProductName
                        </td>
                        <td>@Model.Items[i].ExpectedQuantity</td>
                        <td><input asp-for="Items[@i].CountedQuantity" class="form-control" /></td>
                        <td><input asp-for="Items[@i].Note" class="form-control" /></td>
                    </tr>
                }
            </tbody>
        </table>

        <button type="submit" class="main-btn success-btn-outline rounded-md btn-hover my-3">Lưu</button>
        <a asp-action="Index" class="main-btn danger-btn-outline rounded-md btn-hover">Hủy</a>
    </form>
</div>