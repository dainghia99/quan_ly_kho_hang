@model quan_ly_kho_hang.Models.Inventory

<h2>Chi tiết kiểm kê</h2>

<p><b>Mã:</b> @Model.InventoryNumber</p>
<p><b>Trạng thái:</b> @Model.Status</p>
<p><b>Ghi chú:</b> @Model.Notes</p>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Sản phẩm</th>
            <th>Tồn hệ thống</th>
            <th>Đếm thực tế</th>
            <th>Chênh lệch</th>
            <th>Ghi chú</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Items)
        {
            <tr>
                <td>@item.ProductName</td>
                <td>@item.ExpectedQuantity</td>
                <td>@item.CountedQuantity</td>
                <td>@item.Difference</td>
                <td>@item.Note</td>
            </tr>
        }
    </tbody>
</table>

<form asp-action="Complete" asp-route-id="@Model.Id" method="post">
    <button type="submit" class="btn btn-success">Hoàn tất</button>
</form>

<form asp-action="Apply" asp-route-id="@Model.Id" method="post">
    <button type="submit" class="btn btn-primary">Áp dụng tồn kho</button>
</form>

<form asp-action="Cancel" asp-route-id="@Model.Id" method="post">
    <button type="submit" class="btn btn-danger">Hủy kiểm kê</button>
</form>

<a asp-action="Index" class="btn btn-link">Quay lại</a>
