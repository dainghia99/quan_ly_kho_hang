@model quan_ly_kho_hang.Models.Inventory

@{
    ViewData["Title"] = "Cập Nhật Trạng Thái";
    ViewData["Slug"] = "Cập nhật trạng thái";
}

<p class="my-3"><b>Mã:</b> @Model.InventoryNumber</p>
<p class="my-3"><b>Trạng thái:</b> @Model.Status</p>
<p class="my-3"><b>Ghi chú:</b> @Model.Notes</p>

<div class="row">
    <div class="col-lg-12">
    <div class="card-style mb-30">
        <h6 class="mb-10">Cập Nhật Thông Tin</h6>
        <p class="text-sm mb-20">
        Danh sách các sản phẩm đã kiểm kê
        </p>
        <div class="table-wrapper table-responsive">
        <table class="table">
            <thead>
            <tr>
                <th><h6>Sản Phẩm</h6></th>
                <th><h6>Tồn Hệ Thống</h6></th>
                <th><h6>Đếm Thực Tế</h6></th>
                <th><h6>Chênh Lệch</h6></th>
                <th><h6>Ghi Chú</h6></th>
            </tr>
            <!-- end table row-->
            </thead>
            <tbody>
                @foreach (var r in Model.Items)
                {
                    <tr>
                        
                        <td class="min-width">
                            <div class="lead">
                                <div class="lead-text">
                                <p>@r.ProductName</p>
                                </div>
                            </div>
                        </td>
                            
                        
                        
                        <td>
                            <div class="lead">
                                <div class="lead-text">
                                    <p>@r.ExpectedQuantity</p>
                                </div>
                            </div>
                        </td>

                        <td>
                            <div class="lead">
                                <div class="lead-text">
                                    <p>@r.CountedQuantity</p>
                                </div>
                            </div>
                        </td>

                        <td>
                            <div class="lead">
                                <div class="lead-text">
                                    <p>@r.Difference</p>
                                </div>
                            </div>
                        </td>

                        <td>
                            <div class="lead">
                                <div class="lead-text">
                                    <p>@r.Note</p>
                                </div>
                            </div>
                        </td>
                        
                    </tr>
                }

            <tr>
            </tbody>
        </table>
        <!-- end table -->
        </div>
    </div>
    <!-- end card -->
    </div>
    <!-- end col -->
</div>

<h4>Các trạng thái</h4>

<div class="d-flex gap-3 align-items-center">
    <form asp-action="Complete" asp-route-id="@Model.Id" method="post">
        <button type="submit" class="main-btn success-btn-outline rounded-md btn-hover my-3">Hoàn tất</button>
    </form>

    <form asp-action="Apply" asp-route-id="@Model.Id" method="post">
        <button type="submit" class="main-btn info-btn-outline rounded-md btn-hover my-3">Áp dụng tồn kho</button>
    </form>

    <form asp-action="Cancel" asp-route-id="@Model.Id" method="post">
        <button type="submit" class="main-btn danger-btn-outline rounded-md btn-hover">Hủy kiểm kê</button>
    </form>
</div>


<a asp-action="Index" class="main-btn success-btn-outline rounded-md btn-hover my-3">Quay lại</a>