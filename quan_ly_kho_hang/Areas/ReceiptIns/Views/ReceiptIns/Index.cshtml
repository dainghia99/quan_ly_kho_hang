@model IEnumerable<quan_ly_kho_hang.Models.ReceiptIn>

<h2>Danh sách Phiếu Nhập</h2>
<a asp-action="Create" class="btn btn-primary mb-3">Tạo Phiếu Nhập</a>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Mã Phiếu</th>
            <th>Ngày Tạo</th>
            <th>Người Tạo</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var r in Model)
    {
        <tr>
            <td>@r.ReceiptNumber</td>
            <td>@r.CreatedAt.ToLocalTime()</td>
            <td>@r.CreatedByUserEmail</td>
            <td>
                <a asp-action="Details" asp-route-id="@r.Id" class="btn btn-info btn-sm">Chi tiết</a>
                <a asp-action="Edit" asp-route-id="@r.Id" class="btn btn-info btn-sm">Chỉnh sửa</a>
                <a asp-action="Delete" asp-route-id="@r.Id" class="btn btn-danger btn-sm">Xóa</a>
            </td>
        </tr>
    }
    </tbody>
</table>
