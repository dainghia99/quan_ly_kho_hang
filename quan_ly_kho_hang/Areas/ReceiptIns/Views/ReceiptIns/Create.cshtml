@model quan_ly_kho_hang.Models.ReceiptIn
@{
    ViewData["Title"] = "Tạo Phiếu Nhập";
    ViewData["Slug"] = "Tạo mới";
    var products = ViewBag.Products as List<quan_ly_kho_hang.Models.Product>;
}

<div class="input-style-1">
    <form asp-action="Create" method="post">
        <div asp-validation-summary="All" class="text-danger"></div>
        <div class="mb-3">
            <label>Mã Phiếu</label>
            <input asp-for="ReceiptNumber" readonly />
        </div>

        <h4 class="my-3">Danh sách sản phẩm</h4>
        <div id="items">
            <div class="item row mb-2 select-style-1">
                <div class="select-position">
                    <select name="Items[0].ProductId">
                        @foreach (var p in products)
                        {
                            <option value="@p.Id">@p.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-3 my-5">
                    <input type="number" name="Items[0].Quantity" placeholder="Số lượng" />
                </div>
                <div class="col-md-3 my-5">
                    <input type="number" step="0.01" name="Items[0].UnitPrice" placeholder="Đơn giá" />
                </div>
            </div>
        </div>

        <button type="submit" class="main-btn success-btn-outline rounded-md btn-hover my-3">Lưu</button>
        <a asp-action="Index" class="main-btn danger-btn-outline rounded-md btn-hover">Hủy</a>
    </form>
</div>