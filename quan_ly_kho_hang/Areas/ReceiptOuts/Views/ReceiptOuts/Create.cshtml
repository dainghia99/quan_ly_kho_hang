@model quan_ly_kho_hang.Models.ReceiptOut
@{
    ViewData["Title"] = "Tạo Phiếu Xuất";
    ViewData["Slug"] = "Tạo mới";
    var products = ViewBag.Products as List<quan_ly_kho_hang.Models.Product>;
}
<div class="input-style-1">
    <form asp-action="Create" method="post">
        <div asp-validation-summary="All" class="text-danger"></div>

        <div class="mb-3">
            <label>Mã Phiếu</label>
            <input asp-for="ReceiptNumber" readonly />
        </div>

        <h4>Danh sách sản phẩm xuất</h4>
        <table class="table" id="itemsTable">
            <thead>
                <tr>
                    <th>Sản phẩm</th>
                    <th>Số lượng</th>
                    <th>Đơn giá</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>
                        <div class="select-style-1 col-md-8">
                            <div class="select-position">
                                <select name="Items[0].ProductId">
                                    @foreach (var p in products)
                                    {
                                        <option value="@p.Id">@p.Name (@p.Quantity tồn)</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </td>
                    <td>
                        <div class="col-md-8">
                            <input name="Items[0].Quantity" type="number"  />
                        </div>
                    </td>
                    <td>
                        <div class="col-md-8">
                            <input  name="Items[0].UnitPrice" type="number" step="0.01" />
                        </div>
                     </td>
                    <td><button type="button" class="mx-3 main-btn danger-btn-outline rounded-md btn-hover" onclick="removeRow(this)"><i class="lni lni-trash-can"></i></button></td>
                </tr>
            </tbody>
        </table>

        <button type="button" class="main-btn success-btn-outline rounded-md btn-hover my-3" onclick="addRow()">+ Thêm dòng</button>

        <button type="submit" class="main-btn success-btn-outline rounded-md btn-hover my-3">Lưu</button>
        <a asp-action="Index" class="main-btn success-btn-outline rounded-md btn-hover my-3">Quay lại</a>
    </form>

</div>

@section Scripts {
    <script>
        let rowIndex = 1;
        function addRow() {
            let table = document.getElementById("itemsTable").getElementsByTagName("tbody")[0];
            let row = table.insertRow();
            row.innerHTML = `
                <td>
                    <div class="select-style-1 col-md-8">
                       <div class="select-position">
                            <select name="Items[${rowIndex}].ProductId" >
                                @foreach (var p in products)
                                {
                                    <text><option value="@p.Id">@p.Name (@p.Quantity tồn)</option></text>
                                }
                            </select>
                        </div>
                    </div>
                </td>
                <td>
                    <div class="col-md-8">
                        <input name="Items[${rowIndex}].Quantity" type="number"/>
                    </div>
                </td>
                <td>
                    <div class="col-md-8">
                        <input name="Items[${rowIndex}].UnitPrice" type="number" step="0.01"/>
                    </div>
                </td>
                <td><button type="button" class="mx-3 main-btn danger-btn-outline rounded-md btn-hover" onclick="removeRow(this)"><i class="lni lni-trash-can"></i></button></td>
            `;
            rowIndex++;
        }
        function removeRow(btn) {
            btn.closest("tr").remove();
        }
    </script>
}
