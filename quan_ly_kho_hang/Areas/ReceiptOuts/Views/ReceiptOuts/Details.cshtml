@model quan_ly_kho_hang.Models.ReceiptOut
@{
    var products = ViewBag.Products as List<quan_ly_kho_hang.Models.Product>;
}

<h2>Chi tiết Phiếu Xuất</h2>

<div class="mb-3">
    <label><strong>Mã Phiếu:</strong></label>
    <span>@Model.ReceiptNumber</span>
</div>
<div class="mb-3">
    <label><strong>Ngày tạo:</strong></label>
    <span>@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
</div>
<div class="mb-3">
    <label><strong>Người tạo:</strong></label>
    <span>@Model.CreatedByUserEmail</span>
</div>

<h4>Danh sách sản phẩm xuất</h4>
<table class="table table-bordered">
    <thead>
        <tr>
            <th>Tên sản phẩm</th>
            <th>Số lượng</th>
            <th>Đơn giá</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Items)
        {
            var product = products?.FirstOrDefault(p => p.Id == item.ProductId);
            <tr>
                <td>@(product?.Name ?? item.ProductId)</td>
                <td>@item.Quantity</td>
                <td>@item.UnitPrice.ToString("N0")</td>
            </tr>
        }
    </tbody>
</table>

<a asp-action="Index" class="btn btn-secondary">Quay lại</a>
