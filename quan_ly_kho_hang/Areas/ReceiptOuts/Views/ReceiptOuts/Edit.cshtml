@model quan_ly_kho_hang.Models.ReceiptOut
@{
    ViewData["Title"] = "Chỉnh Sửa Phiếu Xuất Kho";
    ViewData["Slug"] = "Sửa";
    var products = ViewBag.Products as List<quan_ly_kho_hang.Models.Product>;
}
<div class="input-style-1">
    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="Id" />

        <div class="mb-3">
            <label class="form-label">Mã Phiếu</label>
            <input asp-for="ReceiptNumber" readonly />
        </div>

        <h4>Danh sách sản phẩm xuất</h4>
        <table class="table" id="itemsTable">
            <thead>
                <tr>
                    <th>Sản phẩm</th>
                    <th>Số lượng</th>
                    <th>Đơn giá</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < Model.Items.Count; i++)
                {
                    <tr>
                        <td>
                            <div class="select-style-1 col-md-8">
                                <div class="select-position">
                                    <select name="Items[@i].ProductId">
                                        @foreach (var p in products)
                                        {
                                            if (p.Id == Model.Items[i].ProductId)
                                            {
                                                <option value="@p.Id" selected="selected">@p.Name (@p.Quantity tồn)</option>
                                            }
                                            else
                                            {
                                                <option value="@p.Id">@p.Name (@p.Quantity tồn)</option>
                                            }
                                        }
                                    </select>
                                </div>
                            </div>
                        </td>
                        <td>
                            <div class="col-md-8">
                                <input name="Items[@i].Quantity"
                                   value="@Model.Items[i].Quantity"
                                   type="number"
                                   />
                            </div>
                        </td>
                        <td>
                            <div class="col-md-8">
                                <input name="Items[@i].UnitPrice"
                                       value="@Model.Items[i].UnitPrice"
                                       type="number"
                                       step="0.01"
                                       />
                            </div>
                        </td>
                        <td>
                            <button type="button" class="mx-3 main-btn danger-btn-outline rounded-md btn-hover" onclick="removeRow(this)"><i class="lni lni-trash-can"></i></button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <button type="button" class="main-btn success-btn-outline rounded-md btn-hover my-3" onclick="addRow()">+ Thêm dòng</button>

        <div class="mb-3">
            <label>Người tạo</label>
            <p>@Model.CreatedByUserEmail</p>
            <input type="hidden" asp-for="CreatedByUserEmail" />
        </div>

        <button type="submit" class="main-btn success-btn-outline rounded-md btn-hover my-3">Cập nhật</button>
        <a asp-action="Index" class="main-btn success-btn-outline rounded-md btn-hover my-3">Quay lại</a>
    </form>
</div>


@section Scripts {
    <script>
        let rowIndex = @Model.Items.Count;

        function addRow() {
            let table = document.querySelector("#itemsTable tbody");
            let row = table.insertRow();

            let productOptions = `
                @foreach (var p in products)
                {
                    <text><option value="@p.Id">@p.Name (@p.Quantity tồn)</option></text>
                }
            `;

            row.innerHTML = `
                <td>
                     <div class="select-style-1 col-md-8">
                         <div class="select-position">
                            <select name="Items[${rowIndex}].ProductId">
                                ${productOptions}
                            </select>
                        </div>
                    </div>
                </td>
                <td>
                    <div class="col-md-8">
                        <input name="Items[${rowIndex}].Quantity" type="number" />
                    </div>
                 </td>
                <td>
                    <div class="col-md-8">
                        <input name="Items[${rowIndex}].UnitPrice" type="number" step="0.01"/>
                    </div>
                </td>
                <td><button type="button" class="mx-3 main-btn danger-btn-outline rounded-md btn-hover" onclick="removeRow(this)"><i class="lni lni-trash-can"></button></td>
            `;
            rowIndex++;
        }

        function removeRow(btn) {
            btn.closest("tr").remove();
        }
    </script>
}
