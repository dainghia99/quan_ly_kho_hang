@model quan_ly_kho_hang.Models.ReceiptOut
@{
    var products = ViewBag.Products as List<quan_ly_kho_hang.Models.Product>;
}

<h2>Sửa Phiếu Xuất</h2>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label class="form-label">Mã Phiếu</label>
        <input asp-for="ReceiptNumber" class="form-control" readonly />
    </div>

    <h4>Danh sách sản phẩm xuất</h4>
    <table class="table" id="itemsTable">
        <thead>
            <tr>
                <th>Sản phẩm</th>
                <th>Số lượng</th>
                <th>Đơn giá</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @for (int i = 0; i < Model.Items.Count; i++)
            {
                <tr>
                    <td>
                        <select name="Items[@i].ProductId" class="form-select">
                            @foreach (var p in products)
                            {
                                if (p.Id == Model.Items[i].ProductId)
                                {
                                    <option value="@p.Id" selected="selected">@p.Name (@p.Quantity tồn)</option>
                                }
                                else
                                {
                                    <option value="@p.Id">@p.Name (@p.Quantity tồn)</option>
                                }
                            }
                        </select>
                    </td>
                    <td>
                        <input name="Items[@i].Quantity"
                               value="@Model.Items[i].Quantity"
                               type="number"
                               class="form-control" />
                    </td>
                    <td>
                        <input name="Items[@i].UnitPrice"
                               value="@Model.Items[i].UnitPrice"
                               type="number"
                               step="0.01"
                               class="form-control" />
                    </td>
                    <td>
                        <button type="button" class="btn btn-danger btn-sm" onclick="removeRow(this)">X</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <button type="button" class="btn btn-secondary mb-3" onclick="addRow()">+ Thêm dòng</button>

    <div class="mb-3">
        <label class="form-label">Người tạo</label>
        <p class="form-control-plaintext">@Model.CreatedByUserEmail</p>
        <input type="hidden" asp-for="CreatedByUserEmail" />
    </div>

    <button type="submit" class="btn btn-success">Cập nhật</button>
    <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
</form>

@section Scripts {
    <script>
        let rowIndex = @Model.Items.Count;

        function addRow() {
            let table = document.querySelector("#itemsTable tbody");
            let row = table.insertRow();

            let productOptions = `
                @foreach (var p in products)
                {
                    <text><option value="@p.Id">@p.Name (@p.Quantity tồn)</option></text>
                }
            `;

            row.innerHTML = `
                <td>
                    <select name="Items[${rowIndex}].ProductId" class="form-select">
                        ${productOptions}
                    </select>
                </td>
                <td><input name="Items[${rowIndex}].Quantity" type="number" class="form-control" /></td>
                <td><input name="Items[${rowIndex}].UnitPrice" type="number" step="0.01" class="form-control" /></td>
                <td><button type="button" class="btn btn-danger btn-sm" onclick="removeRow(this)">X</button></td>
            `;
            rowIndex++;
        }

        function removeRow(btn) {
            btn.closest("tr").remove();
        }
    </script>
}
